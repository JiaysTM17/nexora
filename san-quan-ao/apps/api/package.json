    "@nestjs/common": "^11.0.0", "@nestjs/core": "^11.0.0", "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0", "@nestjs/throttler": "^6.4.0",
    "reflect-metadata": "^0.2.2", "rxjs": "^7.8.2", "zod": "^4.0.0",
    "cookie-parser": "^1.4.7", "helmet": "^8.0.0", "dotenv": "^17.0.0",
    "bullmq": "^5.0.0", "ioredis": "^5.0.0"
